// workflow-self-recursive 配置 — 组件维度 = WSR 工作流组件（自原全局词汇迁移）。
// 由 `pctl init` 生成模板后按 WSR 实际使用定制；pctl 任何命令都不会覆盖本文件。
// 定制完成后运行 `pctl install` 安装全部资产（缓存 / 表单 / labels / 技能 / .gitignore）。
export default {
  version: 1,
  pctl: { minVersion: "0.8.0" },
  features: ["requirements", "plans", "releases", "skills"],
  vocabulary: {
    components: [
      { name: "component:execution", color: "C5DEF5", description: "workstream: execution" },
      { name: "component:evidence", color: "BFD4F2", description: "workstream: evidence" },
      { name: "component:evolution", color: "D4C5F9", description: "workstream: evolution" },
      { name: "component:contracts", color: "F9D0C4", description: "workstream: system contracts" },
      { name: "component:workflow-package", color: "FEF2C0", description: "workstream: workflow package" },
      { name: "component:bi", color: "C2E0C6", description: "workstream: BI / visualization" },
      { name: "component:meta", color: "EDEDED", description: "mechanism improvements about this process itself" },
    ],
  },
  authority: {
    release: {
      owner: "firestige",
      environment: "release",
      requiredStatusCheck: "release-governance",
      codeownerPaths: [
        ".github/workflows/**",
        ".github/actions/**",
        "scripts/check-*",
        ".github/CODEOWNERS",
      ],
      reviewers: ["firestige"],
    },
  },
  // gitignore 默认 true：install 会把 .project/ 幂等追加进 WSR 的 .gitignore，不动其他条目
};
